{
  "name": "kishan-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:content && npm run validate:cms && npm run typecheck && vite build && tsx scripts/prerender.ts",
    "preview": "tsx scripts/serve-pages.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate-legacy.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:cms": "tsx scripts/validate-cms-config.ts",
    "test": "playwright test",
    "test:build": "playwright test -c playwright.build.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "yaml": "^2.9.1"
  }
}
